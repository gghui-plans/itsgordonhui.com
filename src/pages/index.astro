---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.featureOrder - b.data.featureOrder)
  .slice(0, 4);
---

<BaseLayout>
  <section class="hero shell section-pad">
    <div class="hero__content">
      <p class="eyebrow">Gordon Hui, P.Eng.</p>
      <h1>Bringing people, evidence, and decisions together.</h1>
      <p class="hero__lede">I’m a transportation engineer, project leader, and community builder. I help municipalities work through mobility choices, build shared direction, and move from conversation to action.</p>
      <div class="button-row">
        <a class="button button--primary" href="/work/">View selected work</a>
        <a class="text-link" href="/about/">How I work <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="decision-field" aria-label="An abstract network showing people, evidence, and decisions connecting">
      <span class="decision-field__label decision-field__label--people">People</span>
      <span class="decision-field__label decision-field__label--evidence">Evidence</span>
      <span class="decision-field__label decision-field__label--decisions">Decisions</span>
      <span class="decision-field__node decision-field__node--one"></span>
      <span class="decision-field__node decision-field__node--two"></span>
      <span class="decision-field__node decision-field__node--three"></span>
      <span class="decision-field__line decision-field__line--one"></span>
      <span class="decision-field__line decision-field__line--two"></span>
      <span class="decision-field__line decision-field__line--three"></span>
    </div>
  </section>

  <section class="point-of-view">
    <div class="shell statement-grid">
      <p class="section-index">01 / Approach</p>
      <div>
        <h2>Good decisions need a clear account of what people value and what the evidence shows.</h2>
        <p>My work creates room for different perspectives, explains the choices in plain language, and gives decision-makers a practical way forward. Technical analysis provides the foundation. Well-run conversations help communities use it.</p>
      </div>
    </div>
  </section>

  <section class="shell section-pad preview-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2>Municipal projects shaped by evidence and conversation.</h2>
      </div>
      <a class="text-link" href="/work/">View all work <span aria-hidden="true">→</span></a>
    </div>
    <div class="project-preview-grid">
      {projects.map((project, index) => (
        <a class:list={['project-preview', { 'project-preview--feature': index === 0 }]} href={`/work/${project.id}/`}>
          <span class="project-preview__meta">{project.data.status} · {project.data.category}</span>
          <h3>{project.data.shortTitle}</h3>
          <p>{project.data.summary}</p>
          <span class="project-preview__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="shell section-pad thinking-preview">
    <div class="statement-grid">
      <p class="section-index">03 / Thinking</p>
      <div>
        <p class="eyebrow">Selected thinking</p>
        <h2>Questions that connect municipal practice with public decisions.</h2>
        <div class="thinking-list">
          <a href="/insights/would-we-build-it-without-the-grant/">
            <span>Would we build it without the grant? A practical guide to municipal transportation grant decisions</span>
            <span aria-hidden="true">→</span>
          </a>
          <a href="/insights/">
            <span>From parking reform to parking governance: A municipal framework for managing reduced parking requirements in downtown areas</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="about-preview">
    <div class="shell about-preview__grid">
      <p class="section-index">04 / About</p>
      <div>
        <h2>I help groups understand the choices in front of them and build a practical way forward.</h2>
        <p>I listen carefully, explain technical work in plain language, and create room for different perspectives. I am Manager, Transportation Planning at R.J. Burnside & Associates Limited. This independent website shares selected work and professional perspectives.</p>
        <a class="text-link" href="/about/">Read more about Gordon <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="expertise-band">
    <div class="shell expertise-grid">
      <p class="section-index">02 / Practice</p>
      <div class="expertise-list">
        <span>Project leadership</span>
        <span>Public engagement</span>
        <span>Municipal strategy</span>
        <span>Transportation planning</span>
        <span>Parking management</span>
        <span>Decision support</span>
      </div>
    </div>
  </section>

  <section class="shell section-pad contact-panel">
    <p class="eyebrow">Start a conversation</p>
    <h2>Interested in transportation, community leadership, or municipal decision-making?</h2>
    <a class="button button--primary" href="mailto:hello@itsgordonhui.com">Email Gordon</a>
  </section>
</BaseLayout>
