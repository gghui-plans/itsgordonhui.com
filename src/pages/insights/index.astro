---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const insights = (await getCollection('insights'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());

const dateFormat = new Intl.DateTimeFormat('en-CA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const inDevelopment = [
  'From parking reform to parking governance: A municipal framework for managing reduced parking requirements in downtown areas',
];
---

<BaseLayout
  title="Insights | Gordon Hui"
  description="Original papers, articles, and technical notes from Gordon Hui on municipal transportation, engagement, and decision-making."
>
  <header class="page-hero shell section-pad">
    <p class="eyebrow">Insights</p>
    <h1>Practical questions from municipal transportation work.</h1>
    <p>Original papers, articles, and technical notes. Each one states a clear question, uses evidence, acknowledges practical limits, and explains what the issue means for communities and municipal decisions.</p>
  </header>

  <section class="insights-section shell" aria-labelledby="published-heading">
    <div class="insights-section__intro">
      <p class="section-index" id="published-heading">Published</p>
    </div>
    <div class="insight-list insight-list--published">
      {insights.map((insight, index) => (
        <article>
          <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <p class="eyebrow">
              {insight.data.publicationType} ·{' '}
              <time datetime={insight.data.publishedDate.toISOString().slice(0, 10)}>
                {dateFormat.format(insight.data.publishedDate)}
              </time>
            </p>
            <h2><a href={`/insights/${insight.data.slug}/`}>{insight.data.title}</a></h2>
            {insight.data.subtitle && <p class="insight-list__deck">{insight.data.subtitle}</p>}
            <p>{insight.data.description}</p>
            <a class="text-link" href={`/insights/${insight.data.slug}/`}>Read the paper <span aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  {inDevelopment.length > 0 && (
    <section class="insights-section shell" aria-labelledby="development-heading">
      <div class="insights-section__intro">
        <p class="section-index" id="development-heading">In development</p>
      </div>
      <div class="insight-list">
        {inDevelopment.map((title, index) => (
          <article>
            <span aria-hidden="true">{String(insights.length + index + 1).padStart(2, '0')}</span>
            <div>
              <p class="eyebrow">In development</p>
              <h2>{title}</h2>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="shell section-pad contact-panel">
    <p class="eyebrow">Stay connected</p>
    <h2>New writing will also be shared through LinkedIn.</h2>
    <a class="button button--primary" href="https://www.linkedin.com/in/gghui/">Follow Gordon on LinkedIn</a>
  </section>
</BaseLayout>
