---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found | Gordon Hui" description="The requested page could not be found.">
  <section class="not-found shell section-pad">
    <p class="eyebrow">404 · Page not found</p>
    <h1>This route does not lead to a page.</h1>
    <p>The address may have changed, or the page may still be in development.</p>
    <a class="button button--primary" href="/">Return home</a>
  </section>
</BaseLayout>
