---
import BaseLayout from '../../layouts/BaseLayout.astro';

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Gordon Hui',
  honorificSuffix: 'P.Eng.',
  jobTitle: 'Manager, Transportation Planning',
  url: 'https://itsgordonhui.com',
  sameAs: ['https://www.linkedin.com/in/gghui/'],
  worksFor: {
    '@type': 'Organization',
    name: 'R.J. Burnside & Associates Limited',
  },
};
---

<BaseLayout
  title="About Gordon Hui"
  description="Gordon Hui is a transportation engineer, project leader, and community builder working with municipalities across Ontario."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

  <header class="page-hero page-hero--about shell section-pad">
    <p class="eyebrow">About Gordon</p>
    <h1>I help people work through transportation choices and build a practical way forward.</h1>
  </header>

  <section class="about-intro">
    <div class="shell about-intro__grid">
      <p class="section-index">Profile</p>
      <div class="prose prose--large">
        <p>Gordon Hui, P.Eng., is a transportation engineer, project manager, and community builder. He leads public and stakeholder conversations, helps groups understand competing priorities, and gives decision-makers the information they need to act.</p>
        <p>His experience includes municipal transportation strategy development, parking management, transportation network planning, transportation demand management, road safety, and transportation modelling. He uses that experience to build trust, develop shared direction, and help communities put plans into practice.</p>
        <p>Gordon is a Manager of Transportation Planning at R.J. Burnside & Associates Limited (Burnside). He leads work on transportation and parking systems. This work involves community and stakeholder conversations, technical analysis, and support for municipal decisions. ItsGordonHui.com is his independent professional platform for sharing selected work and original perspectives.</p>
      </div>
    </div>
  </section>

  <section class="working-approach shell section-pad">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Working approach</p>
        <h2>Leadership shown through the work.</h2>
      </div>
    </div>
    <div class="approach-grid">
      <article>
        <span>01</span>
        <h3>Listen carefully</h3>
        <p>Community knowledge helps define the questions a plan needs to answer. I create clear ways for people to participate and make sure their concerns are carried into the work.</p>
      </article>
      <article>
        <span>02</span>
        <h3>Make choices understandable</h3>
        <p>I direct the analysis and explain what it means for service, safety, cost, access, implementation, and community priorities.</p>
      </article>
      <article>
        <span>03</span>
        <h3>Support a sound decision</h3>
        <p>I facilitate conversations, identify areas of agreement, and give decision-makers a clear account of the options and consequences.</p>
      </article>
    </div>
  </section>

  <section class="focus-section">
    <div class="shell focus-section__grid">
      <p class="section-index">Areas of focus</p>
      <ul>
        <li>Community-centred project leadership</li>
        <li>Engagement, facilitation, and consensus building</li>
        <li>Municipal transportation and parking strategy</li>
        <li>Technical analysis and decision support</li>
      </ul>
    </div>
  </section>

  <section class="shell section-pad direct-contact">
    <p class="eyebrow">Contact</p>
    <h2>Continue the conversation.</h2>
    <p>For professional enquiries, speaking, research, or a conversation about municipal transportation:</p>
    <div class="button-row">
      <a class="button button--primary" href="mailto:hello@itsgordonhui.com">hello@itsgordonhui.com</a>
      <a class="text-link" href="https://www.linkedin.com/in/gghui/">Connect on LinkedIn <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
