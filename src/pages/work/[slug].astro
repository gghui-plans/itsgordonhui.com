---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const projectNumber = String(project.data.featureOrder).padStart(2, '0');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.data.title,
  description: project.data.summary,
  author: {
    '@type': 'Person',
    name: 'Gordon Hui',
    url: 'https://itsgordonhui.com',
  },
  about: project.data.category,
  url: new URL(`/work/${project.id}/`, Astro.site).toString(),
};
---

<BaseLayout
  title={`${project.data.title} | Gordon Hui`}
  description={project.data.summary}
  canonicalPath={`/work/${project.id}/`}
  socialImage={false}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <header class="project-hero">
    <div class="shell project-hero__grid">
      <div>
        <a class="back-link" href="/work/">← All work</a>
        <p class="eyebrow">{project.data.status} · {project.data.category}</p>
        <h1>{project.data.title}</h1>
        <p class="project-hero__summary">{project.data.summary}</p>
      </div>
      <div class="project-marker" aria-hidden="true">
        <span>{projectNumber}</span>
        <i></i>
      </div>
    </div>
  </header>

  <section class="project-facts">
    <div class="shell project-facts__grid">
      <dl>
        <div><dt>Client</dt><dd>{project.data.client}</dd></div>
        <div><dt>Employer</dt><dd>{project.data.employer}</dd></div>
        <div><dt>Role</dt><dd>{project.data.role}</dd></div>
        <div><dt>Period</dt><dd>{project.data.years}</dd></div>
      </dl>
      <div class="project-contribution">
        <p class="eyebrow">Leadership contribution</p>
        <p>{project.data.contribution}</p>
      </div>
    </div>
  </section>

  <section class="responsibility-band">
    <div class="shell responsibility-band__grid">
      <p class="section-index">Confirmed responsibilities</p>
      <ul>
        {project.data.responsibilities.map((responsibility) => <li>{responsibility}</li>)}
      </ul>
    </div>
  </section>

  <article class="project-article shell">
    <div class="project-article__aside">
      <p class="eyebrow">Areas of work</p>
      <ul class="tag-list">
        {project.data.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </div>
    <div class="prose">
      <Content />
    </div>
  </article>

  <section class="project-source">
    <div class="shell project-source__grid">
      <div>
        <p class="eyebrow">Project record</p>
        <h2>Read the public project information.</h2>
      </div>
      <a class="button button--light" href={project.data.sourceUrl} target="_blank" rel="noreferrer">
        {project.data.sourceLabel} <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="shell project-credit">
      <p>Project delivered by {project.data.employer} for {project.data.client}. Gordon served as {project.data.role}.</p>
    </div>
  </section>
</BaseLayout>
