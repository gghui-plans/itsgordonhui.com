---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
}

const { project, index = 1 } = Astro.props;
const number = String(index).padStart(2, '0');
---

<article class="project-card" data-category={project.data.category}>
  <a href={`/work/${project.id}/`}>
    <div class="project-card__topline">
      <span>{project.data.client}</span>
      <span>{project.data.status} · {project.data.years}</span>
    </div>
    <div class="project-card__body">
      <p class="project-card__number" aria-hidden="true">{number}</p>
      <div>
        <p class="project-card__category">{project.data.category}</p>
        <h2>{project.data.shortTitle}</h2>
        <p>{project.data.summary}</p>
      </div>
    </div>
    <div class="project-card__footer">
      <span>{project.data.role}</span>
      <span aria-hidden="true">View project →</span>
    </div>
  </a>
</article>
