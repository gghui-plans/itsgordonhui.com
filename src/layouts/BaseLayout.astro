---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  socialImage?: string | false;
}

const {
  title = 'Gordon Hui, P.Eng. | Transportation project leader and community builder',
  description = 'Gordon Hui helps municipalities work through transportation choices, build shared direction, and make practical progress.',
  canonicalPath = Astro.url.pathname,
  socialImage = '/og.png',
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site);
const socialTitle = title.includes('Gordon Hui') ? title : `${title} | Gordon Hui`;
const socialImageUrl = socialImage ? new URL(socialImage, Astro.site) : null;
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f3f0e8" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Gordon Hui" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    {socialImageUrl && <meta property="og:image:width" content="1731" />}
    {socialImageUrl && <meta property="og:image:height" content="909" />}
    {socialImageUrl && <meta property="og:image:alt" content="Gordon Hui. Bringing people, evidence, and decisions together." />}
    <meta name="twitter:card" content={socialImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    {socialImageUrl && <meta name="twitter:image:alt" content="Gordon Hui. Bringing people, evidence, and decisions together." />}
    <title>{socialTitle}</title>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
